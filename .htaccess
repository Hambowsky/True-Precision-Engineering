Options -Indexes
DirectoryIndex index.php

# Drawing uploads on the quote form (mod_php hosts; PHP-FPM hosts use .user.ini)
<IfModule mod_php.c>
  php_value upload_max_filesize 10M
  php_value post_max_size 12M
</IfModule>
<Files ".user.ini">
  Require all denied
</Files>
ErrorDocument 404 /404.php

RewriteEngine On

# Force HTTPS and the bare domain
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://trueprecisionltd.co.uk%{REQUEST_URI} [R=301,L]

# Block direct access to includes and tests
RewriteRule ^(includes|tests)/ - [F,L]

# Old site URLs -> new pages (keeps search rankings)
RewriteRule ^(about|services|contact)/$ /$1 [R=301,L]
RewriteRule ^(home|index\.php)$ / [R=301,L]
RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|feed|xmlrpc\.php)(/.*)?$ / [R=301,L]

# Strip .php from URLs
RewriteCond %{THE_REQUEST} \s/([^.\s?]+)\.php[\s?]
RewriteRule ^ /%1 [R=301,L]

# Serve /about from about.php etc.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([a-z0-9-]+)$ $1.php [L]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(webp|png|jpg|css|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "^llms(-full)?\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/xml application/json
</IfModule>
